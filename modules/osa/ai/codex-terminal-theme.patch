+    /// Refresh colors while preserving interleaved keys and bracketed paste.
+    /// The caller must pause the crossterm event broker before entering.
+    pub(crate) fn refresh_default_colors(timeout: Duration) -> io::Result<Option<DefaultColors>> {
+        let mut tty = Tty::open()?;
+        tty.write_all(b"\x1B]10;?\x1B\\\x1B]11;?\x1B\\")?;
+        let deadline = Instant::now() + timeout;
+        let mut buffer = Vec::new();
+        let result = (|| {
+            loop {
+                tty.read_available(&mut buffer, deadline, MAX_STARTUP_PROBE_BYTES)?;
+                if let Some(colors) = super::windows_replay::terminal_default_colors(&buffer) {
+                    return Ok(Some(colors));
+                }
+                let now = Instant::now();
+                if now >= deadline
+                    || buffer.len() >= MAX_STARTUP_PROBE_BYTES
+                    || !tty.poll_readable(deadline.saturating_duration_since(now))?
+                {
+                    return Ok(None);
+                }
+            }
+        })();
+        // Remove only complete, validated replies outside bracketed paste.
+        // Partial replies and all other input stay framed for crossterm.
+        crossterm::event::buffer_input(&refresh_replay_input(&buffer))?;
+        result
+    }
+
+    fn refresh_replay_input(buffer: &[u8]) -> Vec<u8> {
+        let mut replay = Vec::with_capacity(buffer.len());
+        let mut cursor = 0;
+        for range in super::windows_replay::terminal_color_response_ranges(buffer) {
+            replay.extend_from_slice(&buffer[cursor..range.start]);
+            cursor = range.end;
+        }
+        replay.extend_from_slice(&buffer[cursor..]);
+        replay
+    }
+
+    #[test]
+    fn refresh_preserves_interleaved_unicode_keys_and_paste() {
+        let input = "я\x1b]10;rgb:ffff/ffff/ffff\x07\x1b[200~paste\x1b]11;rgb:ffff/0000/0000\x07\x1b[201~\x1b]11;rgb:0000/0000/0000\x1b\\z";
+        assert_eq!(
+            String::from_utf8(refresh_replay_input(input.as_bytes())).unwrap(),
+            "я\x1b[200~paste\x1b]11;rgb:ffff/0000/0000\x07\x1b[201~z"
+        );
+    }
+
+    #[test]
+    fn refresh_preserves_partial_replies_and_unknown_osc() {
+        let input = b"x\x1b]9;hello\x07\x1b]11;rgb:ffff/";
+        assert_eq!(refresh_replay_input(input), input);
+    }
