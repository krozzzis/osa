+    /// Re-read terminal colors on focus or every two seconds while visible.
+    #[cfg(all(unix, not(test)))]
+    pub(crate) fn refresh_terminal_palette(&mut self, force: bool) -> bool {
+        let interval = Duration::from_secs(2);
+        self.frame_requester.schedule_frame_in(interval);
+        if !self.is_terminal_focused() || (!force && self.last_palette_refresh.elapsed() < interval)
+        {
+            return false;
+        }
+        self.last_palette_refresh = std::time::Instant::now();
+        // Unsupported terminals never pay repeated probe timeouts.
+        let (Some(fg), Some(bg)) = (
+            crate::terminal_palette::default_fg(),
+            crate::terminal_palette::default_bg(),
+        ) else {
+            return false;
+        };
+        self.pause_events();
+        let colors = crate::terminal_probe::refresh_default_colors(Duration::from_millis(50));
+        self.resume_events();
+        let Ok(Some(colors)) = colors else {
+            return false;
+        };
+        if colors.fg == fg && colors.bg == bg {
+            return false;
+        }
+        crate::terminal_palette::set_default_colors_from_startup_probe(Some(colors));
+        self.terminal.invalidate_viewport();
+        true
     }

