+
+// Keep the fixed-size notification buffers on a UTF-8 codepoint boundary.
+fn notificationTextLen(text: []const u8, max: usize) usize {
+    var len = @min(text.len, max);
+    while (len > 0 and len < text.len and text[len] & 0xC0 == 0x80) : (len -= 1) {}
+    return len;
+}
+
+test "notification truncation preserves UTF-8" {
+    const testing = std.testing;
+    const text = "Done: Готово 🐝";
+    for (0..text.len + 1) |max| {
+        const len = notificationTextLen(text, max);
+        try testing.expect(len <= max);
+        try testing.expect(std.unicode.utf8ValidateSlice(text[0..len]));
+    }
+    try testing.expectEqual(text.len, notificationTextLen(text, 255));
+    const long = "a" ** 254 ++ "я";
+    try testing.expectEqual(@as(usize, 254), notificationTextLen(long, 255));
+}
