{
  lib,
  stdenv,
  fetchFromGitHub,
  cmake,
  ninja,
  pkg-config,
  qt6,
  mpv,
  taglib,
  wayland,
  wayland-scanner,
  libxcb,
  python3,
  # Python environment carrying the runtime dependencies of the JSON-RPC
  # backends (see the module for what is in it).
  backends,
}:

let
  codegen = python3.withPackages (ps: [
    ps.jinja2
    ps.pyyaml
  ]);
in
stdenv.mkDerivation (finalAttrs: {
  pname = "cloudmus";
  version = "0.6.1";

  src = fetchFromGitHub {
    owner = "cloudmus";
    repo = "cloudmus";
    rev = "f78cadb6733db8a07625c4d99dbe81dfa7ea13fb";
    hash = "sha256-0M3lW8jrdMJWQ4I0YcBX57QvMUTy7wpWtc4nphAOHRg=";
  };

  nativeBuildInputs = [
    cmake
    ninja
    pkg-config
    qt6.wrapQtAppsHook
    qt6.qttools
    wayland-scanner
    codegen
  ];

  buildInputs = [
    qt6.qtbase
    qt6.qtsvg
    mpv
    taglib
    wayland
    libxcb
  ];

  # Upstream builds the Qt front from fronts/qt, with the protocol codegen
  # reached through <source dir>/../.. as the repository root.
  cmakeDir = "../fronts/qt";

  cmakeFlags = [
    "-G"
    "Ninja"
    (lib.cmakeBool "BUILD_TESTING" false)
    # Nothing to cache in a one-shot build, and upstream would otherwise
    # try to use the ccache/mold it finds on the build machine.
    (lib.cmakeBool "CLOUDMUS_CCACHE" false)
    # No DSN is embedded here, so crash reports stay local.
    (lib.cmakeBool "CLOUDMUS_SENTRY" false)
    # CMake derives the version with `git describe`, which has no tag to
    # read in a source tarball.
    "-DCLOUDMUS_VERSION_OVERRIDE=${finalAttrs.version}"
  ];

  # Python protocol stubs for the backends; the C++ side is regenerated by
  # CMake itself. Runs here, while the shell still sits in the source root.
  preConfigure = ''
    ${lib.getExe codegen} protocol/codegen/generate.py --lang python
  '';

  installPhase = ''
    runHook preInstall

    # cmakeConfigurePhase moved into the build directory and never moved back.
    cd "$NIX_BUILD_TOP/$sourceRoot"

    install -Dm755 build/bin/cloudmus-qt $out/bin/cloudmus-qt

    install -Dm644 packaging/appimage/cloudmus-qt.desktop \
      $out/share/applications/cloudmus-qt.desktop
    substituteInPlace $out/share/applications/cloudmus-qt.desktop \
      --replace-fail 'Exec=cloudmus-qt' "Exec=$out/bin/cloudmus-qt"

    install -Dm644 art/logo.png $out/share/icons/hicolor/512x512/apps/cloudmus-qt.png
    install -Dm644 art/logo.svg $out/share/icons/hicolor/scalable/apps/cloudmus-qt.svg

    # The Qt front spawns each backend as a Python process, so the modules
    # and their manifests ship here and are reached through PYTHONPATH.
    mkdir -p $out/lib/cloudmus
    cp -r backends/py-rpc-common/rpc_common $out/lib/cloudmus/
    for backend in backends/*/cloudmus_backend_*; do
      cp -r "$backend" $out/lib/cloudmus/
    done

    # Installed manifests are read only from ~/.config/cloudmus/backends.d,
    # and their argv[0] is used verbatim -- never "python3" from PATH.
    mkdir -p $out/share/cloudmus/backends.d
    for backend in local-folder yandex-music youtube-music; do
      install -Dm644 backends/$backend/manifest.json \
        $out/share/cloudmus/backends.d/$backend.json
      cp backends/$backend/icon.svg $out/share/cloudmus/backends.d/$backend.svg
      substituteInPlace $out/share/cloudmus/backends.d/$backend.json \
        --replace-fail '"python3"' '"${backends}/bin/python3"'
    done

    runHook postInstall
  '';

  postFixup = ''
    wrapProgram $out/bin/cloudmus-qt \
      --prefix PYTHONPATH : "$out/lib/cloudmus"
  '';

  meta = {
    description = "Multi-source music player for Yandex Music, YouTube Music and local files";
    homepage = "https://cloudmus.app";
    changelog = "https://github.com/cloudmus/cloudmus/blob/master/CHANGELOG.md";
    license = lib.licenses.mit;
    mainProgram = "cloudmus-qt";
    platforms = lib.platforms.linux;
  };
})
